---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import DetailHeaderDecor from '../../../components/ui/DetailHeaderDecor.astro';
import JsonLd from '../../../components/layout/JsonLd.astro';
import { getCollection, render } from 'astro:content';
import { buildDeMap, getDeSlug } from '../../../lib/content-helpers';
import { t } from '../../../lib/i18n';

const lang = 'en';
export const prerender = true;

export async function getStaticPaths() {
  const en = await getCollection('blog');
  return en.map((post) => ({ params: { post: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allEn = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const dePosts = await getCollection('blogDe');
const deMap = buildDeMap(dePosts);
const deSlug = getDeSlug(post, deMap);

const currentIndex = allEn.findIndex((p) => p.id === post.id);
const nextPost = allEn[currentIndex + 1] || null;

const dateStr = post.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const altLangUrl = `/blog/${deSlug}/`;
const relatedPosts = allEn
  .filter((p) => p.id !== post.id && p.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);
---

<BaseLayout title={`${post.data.title} — Dragan Balatinac`} description={post.data.description} activeNav="writing" ogType="article" publishedAt={post.data.publishedAt} lang={lang} altLangUrl={altLangUrl}>
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    author: { '@type': 'Person', name: 'Dragan Balatinac', url: 'https://balatinac.dev' },
    publisher: { '@type': 'Person', name: 'Dragan Balatinac' },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    url: new URL(Astro.url.pathname, Astro.site).toString(),
  }} />
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://balatinac.dev/en/' },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: 'https://balatinac.dev/en/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.title },
    ],
  }} />

  <header class="detail-header">
    <DetailHeaderDecor variant="blog" />
    <Breadcrumbs items={[
      { label: t('crumb.home', lang), href: '/en/' },
      { label: t('crumb.writing', lang), href: '/en/blog/' },
      { label: post.data.title },
    ]} />
    <div class="detail-header__content mx-auto max-w-wrap px-5 pt-12 pb-12 sm:px-7 sm:pt-14 sm:pb-14 md:px-8 md:pt-14 md:pb-[60px]">
      <p class="font-mono text-[13px] text-muted m-0 mb-5">{dateStr} · {post.data.readTime || '~5 min read'}</p>
      <h1 class="h1-page leading-[1.1] m-0 mb-5 text-balance">{post.data.title}</h1>
    </div>
  </header>

  <section class="py-3 border-y border-rule font-mono text-[13px] text-muted">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 flex flex-wrap gap-x-6 gap-y-2">
      <span>{t('meta.published', lang)}<strong class="text-fg font-sans font-medium ml-1.5">{dateStr}</strong></span>
      <span>{t('meta.readTime', lang)}<strong class="text-fg font-sans font-medium ml-1.5">{post.data.readTime || '~5 min'}</strong></span>
      <span class="flex gap-2.5 sm:ml-auto">
        {post.data.tags.map((tag) => (
          <a href={`/en/blog/?tag=${tag.toLowerCase()}`} class="text-muted before:content-['#'] before:text-accent hover:text-fg transition-colors">{tag}</a>
        ))}
      </span>
    </div>
  </section>

  <article class="py-12 sm:py-14 md:py-14 pb-16 md:pb-20">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 prose-article">
      <Content />
    </div>
  </article>

{relatedPosts.length > 0 && (
  <section class="border-t border-rule">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 py-10 md:py-14">
      <h2 class="font-mono text-[12px] uppercase tracking-[0.08em] text-muted mb-6">{t('blog.relatedPosts', lang)}</h2>
      <ul class="list-none p-0 m-0">
        {relatedPosts.map((rp) => {
          const rpDate = rp.data.publishedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
          return (
            <li>
              <a class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1 sm:gap-6 sm:items-baseline py-[22px] hover:text-accent transition-colors group" href={`/en/blog/${rp.id}/`}>
                <div>
                  <div class="text-[18px] font-medium leading-snug text-balance">{rp.data.title}</div>
                  <div class="text-[15px] text-muted mt-1 text-pretty max-w-[60ch]">{rp.data.description}</div>
                </div>
                <div class="font-mono text-[12px] sm:text-[13px] text-muted whitespace-nowrap group-hover:text-accent transition-colors">{rpDate}</div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<nav class="border-t border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 grid grid-cols-1 sm:grid-cols-2">
    <a class="py-7 pr-4 hover:text-accent transition-colors" href="/en/blog/">
      <div class="font-mono text-[12px] text-muted mb-1.5">{t('blog.backToWriting', lang)}</div>
      <div class="text-[16px] font-medium">{t('blog.allPosts', lang)}</div>
    </a>
    {nextPost && (
      <a class="py-7 pl-4 text-right border-t sm:border-t-0 sm:border-l border-rule hover:text-accent transition-colors" href={`/en/blog/${nextPost.id}/`}>
        <div class="font-mono text-[12px] text-muted mb-1.5">{t('blog.nextPost', lang)}</div>
        <div class="text-[16px] font-medium">{nextPost.data.title} →</div>
      </a>
    )}
  </div>
</nav>
</BaseLayout>

<style>
  .prose-article :global(h2) { font-weight: 700; font-size: 26px; line-height: 1.25; letter-spacing: -0.015em; margin-top: 48px; margin-bottom: 16px; }
  .prose-article :global(h3) { font-weight: 600; font-size: 20px; margin-top: 28px; margin-bottom: 8px; }
  .prose-article :global(p) { font-size: 17px; line-height: 1.75; margin: 0 0 16px; text-wrap: pretty; }
  .prose-article :global(ul), .prose-article :global(ol) { list-style: none; padding: 0; margin: 0 0 22px; counter-reset: ord; }
  .prose-article :global(li) { position: relative; padding: 8px 0 8px 26px; font-size: 17px; line-height: 1.65; }
  .prose-article :global(ul li::before) { content: "—"; position: absolute; left: 0; color: var(--accent); }
  .prose-article :global(ol li) { counter-increment: ord; }
  .prose-article :global(ol li::before) { content: counter(ord, decimal-leading-zero); position: absolute; left: 0; color: var(--accent); font-family: var(--font-mono); font-size: 13px; top: 10px; }
  .prose-article :global(blockquote) { border-left: 2px solid var(--accent); padding: 4px 0 4px 18px; margin: 28px 0; font-size: 19px; line-height: 1.45; font-style: italic; }
  .prose-article :global(blockquote p) { font-size: inherit; line-height: inherit; margin: 0; }
  .prose-article :global(pre) { padding: 20px 24px; margin: 0 0 24px; font-size: 13px; line-height: 1.65; border-radius: 6px; overflow-x: auto; white-space: pre; }
  .prose-article :global(pre code) { font-family: var(--font-mono); background: none; padding: 0; font-size: inherit; }
  .prose-article :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 56px 0; }
  .prose-article :global(a) { color: var(--fg); border-bottom: 1px solid var(--muted); transition: color 0.15s, border-color 0.15s; }
  .prose-article :global(a:hover) { color: var(--accent); border-color: var(--accent); }
  .prose-article :global(p:last-child > em:only-child) { font-family: var(--font-mono); font-size: 13px; color: var(--muted); font-style: normal; }
</style>
