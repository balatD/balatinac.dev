---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import AmbientBlobs from '../components/layout/AmbientBlobs.astro';
import SEO from '../components/layout/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../lib/i18n';
import { t, langSwitchUrl } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
  activeNav?: 'about' | 'work' | 'writing' | 'contact';
  lang?: Lang;
  altLangUrl?: string;
}

const {
  title,
  description = 'Portfolio of Dragan Balatinac — backend engineer building quiet, reliable systems.',
  ogImage,
  ogType,
  publishedAt,
  noindex,
  activeNav,
  lang = 'de',
  altLangUrl,
} = Astro.props;

const altUrl = altLangUrl || langSwitchUrl(Astro.url.pathname, lang);
const altLang = lang === 'de' ? 'en' : 'de';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      publishedAt={publishedAt}
      noindex={noindex}
      lang={lang}
    />

    <!-- hreflang for SEO -->
    <link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <link rel="alternate" hreflang={altLang} href={new URL(altUrl, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(lang === 'de' ? Astro.url.pathname : altUrl, Astro.site).toString()} />

    <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/hanken-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="application/rss+xml" title="Dragan Balatinac RSS" href="/rss.xml" />

    <ClientRouter />

    <meta name="generator" content={Astro.generator} />

    <!-- Theme + motion init to prevent FOUC / FOUC-free reveals -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (!theme) {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
        // Enable reveal motion only when allowed — gates the hidden resting state in CSS.
        // No JS / reduced-motion → class never added → content renders visible.
        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduced) document.documentElement.classList.add('has-motion');
      })();
    </script>
  </head>
  <body class="bg-bg text-fg font-sans antialiased leading-relaxed text-[17px]">
    <a href="#main" class="skip-link">
      {t('skip', lang)}
    </a>

    <AmbientBlobs />

    <!-- zed-style structural rails framing the content column -->
    <div class="frame-lines" aria-hidden="true"></div>

    <Header activeNav={activeNav} lang={lang} altLangUrl={altUrl} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <dialog id="lightbox" class="lightbox-dialog" aria-label={t('lightbox.caption', lang)}>
      <button class="lightbox-close" aria-label={t('lightbox.close', lang)} type="button">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18M6 6l12 12" /></svg>
      </button>
      <div class="lightbox-inner">
        <img class="lightbox-img" src="" alt="" aria-describedby="lightbox-caption" />
        <p id="lightbox-caption" class="lightbox-caption"></p>
      </div>
    </dialog>

    <script>
      function syncThemeIcons() {
        const theme = document.documentElement.getAttribute('data-theme') || 'light';
        document.querySelectorAll<HTMLElement>('.icon-sun, #icon-sun').forEach(el => el.style.display = theme === 'dark' ? 'block' : 'none');
        document.querySelectorAll<HTMLElement>('.icon-moon, #icon-moon').forEach(el => el.style.display = theme === 'dark' ? 'none' : 'block');
      }

      function setTheme(mode: string, toggleEl?: HTMLElement) {
        const html = document.documentElement;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Fallback: instant switch if no View Transition API or reduced motion preferred
        if (!document.startViewTransition || prefersReducedMotion) {
          html.setAttribute('data-theme', mode);
          try { localStorage.setItem('theme', mode); } catch (e) {}
          syncThemeIcons();
          return;
        }

        // Safari's clip-path animation on view-transition pseudo-elements is janky —
        // use a fast crossfade instead.
        const isSafari = /Safari\//.test(navigator.userAgent) && !/Chrome\//.test(navigator.userAgent) && !/Edg\//.test(navigator.userAgent);

        // Calculate circle origin from toggle button position
        const rect = toggleEl?.getBoundingClientRect();
        const x = rect ? rect.left + rect.width / 2 : innerWidth / 2;
        const y = rect ? rect.top + rect.height / 2 : innerHeight / 2;
        const endRadius = Math.hypot(
          Math.max(x, innerWidth - x),
          Math.max(y, innerHeight - y)
        );

        // Override view transition styles for circular reveal
        html.classList.add('theme-transition');

        const transition = document.startViewTransition(async () => {
          html.setAttribute('data-theme', mode);
          try { localStorage.setItem('theme', mode); } catch (e) {}
          syncThemeIcons();
        });

        transition.ready.then(() => {
          if (isSafari) {
            // Fast crossfade — lightweight, no clip-path compositing
            html.animate(
              { opacity: [0, 1] },
              { duration: 200, easing: 'ease-out', pseudoElement: '::view-transition-new(root)' }
            );
          } else {
            // Circular reveal — smooth on Chromium/Firefox
            html.animate(
              {
                clipPath: [
                  `circle(0px at ${x}px ${y}px)`,
                  `circle(${endRadius}px at ${x}px ${y}px)`,
                ],
              },
              {
                duration: 500,
                easing: 'cubic-bezier(0.4, 0, 0.2, 1)',
                pseudoElement: '::view-transition-new(root)',
              }
            );
          }
        });

        transition.finished.then(() => {
          html.classList.remove('theme-transition');
        });
      }

      function clampTooltip(trigger: HTMLElement) {
        const bubble = trigger.querySelector<HTMLElement>('.tooltip-bubble');
        if (!bubble) return;
        bubble.style.setProperty('--tip-shift', '0px');
        const margin = 12;
        const triggerRect = trigger.getBoundingClientRect();
        const bubbleRect = bubble.getBoundingClientRect();
        const center = triggerRect.left + triggerRect.width / 2;
        const half = bubbleRect.width / 2;
        const vw = document.documentElement.clientWidth;
        let shift = 0;
        if (center - half < margin) shift = margin - (center - half);
        else if (center + half > vw - margin) shift = (vw - margin) - (center + half);
        bubble.style.setProperty('--tip-shift', shift + 'px');
      }

      function setMenuOpen(open: boolean) {
        const menu = document.getElementById('mobile-menu');
        const toggle = document.getElementById('mobile-menu-toggle');
        if (!menu || !toggle) return;
        menu.setAttribute('data-open', String(open));
        toggle.setAttribute('aria-expanded', String(open));
        toggle.querySelector<HTMLElement>('.menu-icon-closed')?.classList.toggle('hidden', open);
        toggle.querySelector<HTMLElement>('.menu-icon-open')?.classList.toggle('hidden', !open);
      }

      function initPage() {
        syncThemeIcons();

        document.querySelectorAll<HTMLElement>('#theme-toggle, #theme-toggle-desktop').forEach(btn => {
          const fresh = btn.cloneNode(true) as HTMLElement;
          btn.parentNode!.replaceChild(fresh, btn);
          fresh.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            setTheme(current === 'dark' ? 'light' : 'dark', fresh);
          });
        });

        const menuToggle = document.getElementById('mobile-menu-toggle');
        if (menuToggle) {
          const fresh = menuToggle.cloneNode(true) as HTMLElement;
          menuToggle.parentNode!.replaceChild(fresh, menuToggle);
          fresh.addEventListener('click', () => {
            const menu = document.getElementById('mobile-menu');
            const isOpen = menu?.getAttribute('data-open') === 'true';
            setMenuOpen(!isOpen);
          });
        }

        document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a').forEach(link => {
          link.addEventListener('click', () => setMenuOpen(false));
        });

        document.querySelectorAll<HTMLElement>('.tooltip-trigger').forEach(trigger => {
          const handler = () => clampTooltip(trigger);
          trigger.addEventListener('pointerenter', handler);
          trigger.addEventListener('focusin', handler);
          trigger.addEventListener('touchstart', handler, { passive: true });
        });
      }

      if (!(window as any).__menuEscBound) {
        (window as any).__menuEscBound = true;
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setMenuOpen(false);
        });
      }

      document.addEventListener('astro:page-load', initPage);

      // ─── Lightbox ───
      function initLightbox() {
        const found = document.getElementById('lightbox') as HTMLDialogElement | null;
        if (!found) return;
        const dialog: HTMLDialogElement = found;
        const lightboxImg = dialog.querySelector<HTMLImageElement>('.lightbox-img');
        const lightboxCaption = dialog.querySelector<HTMLParagraphElement>('.lightbox-caption');
        const closeBtn = dialog.querySelector<HTMLButtonElement>('.lightbox-close');
        if (!lightboxImg || !lightboxCaption || !closeBtn) return;

        let previouslyFocused: HTMLElement | null = null;
        let scrollY = 0;

        function openLightbox(img: HTMLImageElement) {
          previouslyFocused = img;
          lightboxImg!.src = img.src;
          lightboxImg!.alt = img.alt || '';
          lightboxCaption!.textContent = img.alt || '';

          // Lock background scroll
          scrollY = window.scrollY;
          document.body.classList.add('lightbox-open');
          document.body.style.top = `-${scrollY}px`;

          dialog.showModal();
          closeBtn!.focus();
        }

        function closeLightbox() {
          dialog.close();
          lightboxImg!.src = '';
          lightboxImg!.alt = '';
          lightboxCaption!.textContent = '';

          // Unlock background scroll
          document.body.classList.remove('lightbox-open');
          document.body.style.top = '';
          window.scrollTo(0, scrollY);

          if (previouslyFocused) {
            previouslyFocused.focus();
            previouslyFocused = null;
          }
        }

        // Close button
        closeBtn.addEventListener('click', closeLightbox);

        // Click backdrop (outside inner content) to close
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) closeLightbox();
        });

        // Click the image itself to close
        lightboxImg.addEventListener('click', closeLightbox);

        // Trap Tab focus within the dialog
        dialog.addEventListener('keydown', (e) => {
          if (e.key !== 'Tab') return;
          const focusable = dialog.querySelectorAll<HTMLElement>('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
          if (focusable.length === 0) return;
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey) {
            if (document.activeElement === first) {
              e.preventDefault();
              last.focus();
            }
          } else {
            if (document.activeElement === last) {
              e.preventDefault();
              first.focus();
            }
          }
        });

        // Make prose images clickable
        document.querySelectorAll<HTMLImageElement>('.prose-article img').forEach((img) => {
          // Skip images already wrapped in links
          if (img.closest('a')) return;
          img.style.cursor = 'zoom-in';
          img.setAttribute('role', 'button');
          img.setAttribute('tabindex', '0');
          img.setAttribute('aria-label', img.alt || 'Enlarge image');
          img.addEventListener('click', () => openLightbox(img));
          img.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              e.preventDefault();
              openLightbox(img);
            }
          });
        });
      }

      document.addEventListener('astro:page-load', initLightbox);

      document.addEventListener('astro:after-swap', () => {
        const theme = document.documentElement.getAttribute('data-theme')
          || (() => { try { return localStorage.getItem('theme'); } catch (e) { return null; } })()
          || 'light';
        document.documentElement.setAttribute('data-theme', theme);
        syncThemeIcons();
      });

    </script>

    <!-- ─── Motion: dramatic entrances, scroll choreography & micro-interactions (motion.dev) ─── -->
    <script>
      import { animate, inView, stagger } from 'motion';

      // Annotated as a tuple — a bare literal widens to number[], which fails
      // motion's BezierDefinition and silently knocks out its DOM overload.
      const EASE: [number, number, number, number] = [0.16, 1, 0.3, 1];
      const motionOn = () => document.documentElement.classList.contains('has-motion');

      // Cleanups for scroll/inView observers — cleared between SPA navigations so they don't stack.
      let cleanups: Array<() => void> = [];
      const track = (stop: unknown) => { if (typeof stop === 'function') cleanups.push(stop as () => void); };
      function clearFX() { cleanups.forEach((fn) => { try { fn(); } catch (e) {} }); cleanups = []; }

      function show(el: Element) {
        el.classList.add('is-visible');
        (el as HTMLElement).dataset.revealed = '1';
      }

      function revealIn(items: HTMLElement[], opts: { y?: number; blur?: number; dur?: number; gap?: number; start?: number } = {}) {
        const { y = 26, blur = 8, dur = 0.7, gap = 0.08, start = 0 } = opts;
        animate(
          items,
          { opacity: [0, 1], y: [y, 0], filter: [`blur(${blur}px)`, 'blur(0px)'] },
          { duration: dur, ease: EASE, delay: stagger(gap, { startDelay: start }) }
        );
        items.forEach(show);
      }

      function initReveals() {
        // Hero: plays immediately with the same staggered reveal used across the site.
        const hero = document.querySelector<HTMLElement>('[data-hero]');
        if (hero && !hero.dataset.revealed) {
          hero.dataset.revealed = '1';
          const items = Array.from(hero.querySelectorAll<HTMLElement>('[data-reveal]'));
          revealIn(items, { y: 28, blur: 8, dur: 0.7, gap: 0.09, start: 0.05 });
        }

        // Scroll-triggered groups.
        document.querySelectorAll<HTMLElement>('[data-reveal-group]:not([data-hero])').forEach((group) => {
          const items = Array.from(group.querySelectorAll<HTMLElement>('[data-reveal]')).filter((el) => !el.dataset.revealed);
          if (!items.length) return;
          track(inView(group, () => { revealIn(items); }, { amount: 0.12 }));
        });

        // Standalone reveals.
        document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => {
          if (el.dataset.revealed || el.closest('[data-reveal-group]')) return;
          track(inView(el, () => { revealIn([el]); }, { amount: 0.12 }));
        });
      }

      function initMagnetic() {
        document.querySelectorAll<HTMLElement>('.btn-accent, [data-magnetic]').forEach((el) => {
          if (el.dataset.magneticBound) return;
          el.dataset.magneticBound = '1';
          const strength = 0.35;
          el.addEventListener('pointermove', (e) => {
            if (!motionOn()) return;
            const r = el.getBoundingClientRect();
            const x = (e.clientX - (r.left + r.width / 2)) * strength;
            const y = (e.clientY - (r.top + r.height / 2)) * strength;
            animate(el, { x, y }, { type: 'spring', stiffness: 350, damping: 22 });
          });
          el.addEventListener('pointerleave', () => {
            animate(el, { x: 0, y: 0 }, { type: 'spring', stiffness: 220, damping: 18 });
          });
        });
      }

      function initMotion() {
        clearFX();
        if (!motionOn()) return;
        initReveals();
        initMagnetic();
      }

      document.addEventListener('astro:page-load', initMotion);
      document.addEventListener('astro:before-swap', clearFX);
    </script>
  </body>
</html>
