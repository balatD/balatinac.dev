---
interface BreadcrumbItem {
  label: string;
  href?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav class="breadcrumbs relative z-[1] mx-auto max-w-wrap px-5 sm:px-8 md:px-10 pt-4 text-[14px] text-muted" aria-label="Breadcrumb">
  <ol class="list-none m-0 p-0 flex flex-wrap gap-x-2.5">
    {items.map((item, i) => (
      <li class="flex items-baseline gap-x-2.5">
        {i > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a class="inline-block py-2.5 hover:text-accent transition-colors" href={item.href}>{item.label}</a>
        ) : (
          <span class="py-2.5 text-fg" aria-current="page">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
