---
import BaseLayout from '../../layouts/BaseLayout.astro';
import JsonLd from '../../components/layout/JsonLd.astro';
import Hero from '../../components/sections/Hero.astro';
import About from '../../components/sections/About.astro';
import Work from '../../components/sections/Work.astro';
import Writing from '../../components/sections/Writing.astro';
import Contact from '../../components/sections/Contact.astro';
import { t } from '../../lib/i18n';

const lang = 'en';

export const prerender = true;
---

<BaseLayout
  title={t('title.home', lang)}
  description="Backend developer from NRW. Building quiet, reliable systems with TYPO3, PHP, and the DevOps glue around them."
  lang={lang}
>
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Dragan Balatinac',
    url: 'https://balatinac.dev',
    jobTitle: 'Backend Engineer',
    knowsAbout: ['TYPO3', 'PHP', 'Backend Development', 'DevOps', 'Docker', 'Astro'],
    sameAs: [
      'https://github.com/balatD',
      'https://www.linkedin.com/in/dragan-balatinac/',
    ],
  }} />
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Dragan Balatinac',
    url: 'https://balatinac.dev/en/',
    inLanguage: 'en',
  }} />

  <Hero lang={lang} />
  <About lang={lang} />
  <Work lang={lang} />
  <Writing lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
