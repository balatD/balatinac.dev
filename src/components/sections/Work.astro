---
import { getCollection } from 'astro:content';
import { buildDeMap, getLocalizedEntry } from '../../lib/content-helpers';
import type { Lang } from '../../lib/i18n';
import { t, langPrefix } from '../../lib/i18n';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
const prefix = langPrefix(lang);

const enProjects = await getCollection('projects');
const deProjects = await getCollection('projectsDe');
const projects = enProjects.sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const deMap = buildDeMap(deProjects);
const hasProjects = projects.length > 0;
---

<section id="work" class="py-14 sm:py-16 md:py-20 border-t border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
    <p class="section-label font-mono text-[13px] text-muted m-0 mb-7 md:mb-8">{t('work.label', lang)}</p>
    {hasProjects ? (
      <>
        <ul class="list-none p-0 m-0 divide-y divide-rule">
          {projects.map((project) => {
            const { title, description, slug } = getLocalizedEntry(project, deMap, lang);
            return (
              <li>
                <a class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1 sm:gap-6 sm:items-baseline py-5 hover:text-accent transition-colors group" href={`${prefix}/work/${slug}/`}>
                  <div>
                    <div class="text-[17px] font-medium leading-snug text-balance">{title}</div>
                    <div class="text-[14px] sm:text-[15px] text-muted mt-1 text-pretty">{description}</div>
                  </div>
                  <div class="font-mono text-[12px] sm:text-[13px] text-muted whitespace-nowrap group-hover:text-accent transition-colors">{project.data.year}</div>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="mt-7 font-mono text-[13px]">
          <a class="text-muted hover:text-accent after:content-['_→']" href={`${prefix}/work/`}>{t('work.all', lang)}</a>
        </p>
      </>
    ) : (
      <p class="text-[17px] text-muted">{t('empty.work', lang)}</p>
    )}
  </div>
</section>
