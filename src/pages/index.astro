---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/layout/JsonLd.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Work from '../components/sections/Work.astro';
import Writing from '../components/sections/Writing.astro';
import Contact from '../components/sections/Contact.astro';
import { t } from '../lib/i18n';

const lang = 'de';

export const prerender = true;
---

<BaseLayout
  title={t('title.home', lang)}
  description="Backend-Entwickler aus NRW. Ruhige, zuverlässige Systeme mit TYPO3, PHP und dem DevOps-Klebstoff drumherum."
  lang={lang}
>
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Dragan Balatinac',
    url: 'https://balatinac.dev',
    jobTitle: 'Backend Engineer',
    sameAs: [
      'https://github.com/balatD',
      'https://linkedin.com/in/balatinac',
    ],
  }} />
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Dragan Balatinac',
    url: 'https://balatinac.dev',
  }} />

  <Hero lang={lang} />
  <About lang={lang} />
  <Work lang={lang} />
  <Writing lang={lang} />
  <Contact lang={lang} />
</BaseLayout>
