---
interface BreadcrumbItem {
  label: string;
  href?: string;
  i18n?: string;
}

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<div class="pt-[100px] md:pt-[110px] font-mono text-[13px] text-muted">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 flex flex-wrap gap-2">
    {items.map((item, i) => (
      <>
        {i > 0 && <span class="opacity-50">/</span>}
        {item.href ? (
          <a class="text-muted hover:text-accent transition-colors" href={item.href} data-i18n={item.i18n}>{item.label}</a>
        ) : (
          <span aria-current="page" data-i18n={item.i18n}>{item.label}</span>
        )}
      </>
    ))}
  </div>
</div>
