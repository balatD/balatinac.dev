---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AsciiArt from '../../../components/ui/AsciiArt.astro';
import Card from '../../../components/ui/Card.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import FilterBar from '../../../components/ui/FilterBar.astro';
import { getCollection } from 'astro:content';
import { buildDeMap, getLocalizedEntry } from '../../../lib/content-helpers';
import { t } from '../../../lib/i18n';

const lang = 'en';
export const prerender = true;

const enProjects = await getCollection('projects');
const deProjects = await getCollection('projectsDe');
const sorted = enProjects.sort((a, b) => a.data.order - b.data.order);
const deMap = buildDeMap(deProjects);
const hasProjects = sorted.length > 0;
const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title={t('title.work', lang)} description={t('workIndex.sub', lang)} activeNav="work" lang={lang}>
  <section class="page-intro page-intro--cover" aria-labelledby="page-title">
    <AsciiArt slot="band" lang={lang} class="ascii-cover--band" />
    <Breadcrumbs items={[
      { label: t('crumb.home', lang), href: '/en/' },
      { label: t('workIndex.crumb', lang) },
    ]} />
    <div class="page-intro__copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10" data-reveal-group>
      <h1 id="page-title" class="h1-page m-0 max-w-[15ch]" data-reveal set:html={t('workIndex.heading', lang)} />
      <p class="lead text-muted mt-6 mb-0 max-w-[44ch] text-pretty" data-reveal>{t('workIndex.sub', lang)}</p>
    </div>
  </section>

  {hasProjects ? (
    <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 pt-10 pb-[clamp(72px,9vw,128px)]">
      <FilterBar tags={allTags} total={sorted.length} lang={lang} />
      <ul id="list" class="card-grid mt-8">
        {sorted.map((project) => {
          const { title, description, slug } = getLocalizedEntry(project, deMap, lang);
          const status = project.data.meta?.status;
          return (
            <Card
              href={`/en/work/${slug}/`}
              title={title}
              description={description}
              meta={status ? `${project.data.year} · ${status}` : String(project.data.year)}
              tags={project.data.tags.join(',')}
            />
          );
        })}
      </ul>
    </div>
  ) : (
    <section class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 py-16 md:py-24 text-center">
      <p class="text-[17px] text-muted">{t('empty.work', lang)}</p>
    </section>
  )}
</BaseLayout>
