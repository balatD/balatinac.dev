---
import { getCollection } from 'astro:content';
import { buildDeMap, getLocalizedEntry } from '../../lib/content-helpers';
import type { Lang } from '../../lib/i18n';
import { t, langPrefix } from '../../lib/i18n';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
const prefix = langPrefix(lang);

const enProjects = await getCollection('projects');
const deProjects = await getCollection('projectsDe');
const projects = enProjects.sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const deMap = buildDeMap(deProjects);
const hasProjects = projects.length > 0;
---

<section id="work" class="py-16 sm:py-20 md:py-24 border-t border-rule" data-reveal-group>
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
    <h2 class="section-title m-0 mb-7 md:mb-9" data-reveal>{t('work.label', lang)}</h2>
    {hasProjects ? (
      <>
        <ul class="list-none p-0 m-0">
          {projects.map((project) => {
            const { title, description, slug } = getLocalizedEntry(project, deMap, lang);
            return (
              <li data-reveal>
                <a class="row-link group grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1 sm:gap-6 sm:items-baseline py-5 transition-colors" href={`${prefix}/work/${slug}/`}>
                  <div class="min-w-0">
                    <div class="font-display text-[19px] sm:text-[20px] font-semibold leading-snug text-balance text-fg group-hover:text-accent transition-colors">{title}</div>
                    <div class="text-[14px] sm:text-[15px] text-muted mt-1 text-pretty">{description}</div>
                  </div>
                  <div class="font-mono text-[12px] sm:text-[13px] text-muted whitespace-nowrap">{project.data.year}</div>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="mt-8" data-reveal>
          <a class="cta-link inline-flex items-center gap-2 font-mono text-[13px] text-muted hover:text-accent" href={`${prefix}/work/`}>{t('work.all', lang)} <span aria-hidden="true">→</span></a>
        </p>
      </>
    ) : (
      <p class="text-[17px] text-muted" data-reveal>{t('empty.work', lang)}</p>
    )}
  </div>
</section>
