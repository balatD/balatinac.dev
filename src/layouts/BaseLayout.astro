---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Wordmark from '../components/layout/Wordmark.astro';
import AmbientBlobs from '../components/layout/AmbientBlobs.astro';
import SEO from '../components/layout/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import type { Lang } from '../lib/i18n';
import { t, langPrefix, langSwitchUrl } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
  activeNav?: 'about' | 'work' | 'writing' | 'contact';
  lang?: Lang;
  altLangUrl?: string;
}

const {
  title,
  description = 'Portfolio of Dragan Balatinac — backend engineer building quiet, reliable systems.',
  ogImage,
  ogType,
  publishedAt,
  noindex,
  activeNav,
  lang = 'de',
  altLangUrl,
} = Astro.props;

const prefix = langPrefix(lang);
const altUrl = altLangUrl || langSwitchUrl(Astro.url.pathname, lang);
const altLang = lang === 'de' ? 'en' : 'de';
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      publishedAt={publishedAt}
      noindex={noindex}
    />

    <!-- hreflang for SEO -->
    <link rel="alternate" hreflang={lang} href={new URL(Astro.url.pathname, Astro.site).toString()} />
    <link rel="alternate" hreflang={altLang} href={new URL(altUrl, Astro.site).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(lang === 'de' ? Astro.url.pathname : altUrl, Astro.site).toString()} />

    <link rel="preload" href="/fonts/space-grotesk-latin-400-500-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/space-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="alternate" type="application/rss+xml" title="Dragan Balatinac RSS" href="/rss.xml" />

    <ClientRouter />

    <meta name="generator" content={Astro.generator} />

    <!-- Theme init to prevent FOUC -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (!theme) {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="bg-bg text-fg font-sans antialiased leading-relaxed text-[17px]">
    <a href="#main" class="skip-link">
      {t('skip', lang)}
    </a>

    <AmbientBlobs />

    <Wordmark href={`${prefix}/`} />
    <Header activeNav={activeNav} lang={lang} altLangUrl={altUrl} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      function syncThemeIcons() {
        const theme = document.documentElement.getAttribute('data-theme') || 'light';
        document.querySelectorAll<HTMLElement>('.icon-sun, #icon-sun').forEach(el => el.style.display = theme === 'dark' ? 'block' : 'none');
        document.querySelectorAll<HTMLElement>('.icon-moon, #icon-moon').forEach(el => el.style.display = theme === 'dark' ? 'none' : 'block');
      }

      function setTheme(mode: string) {
        document.documentElement.setAttribute('data-theme', mode);
        try { localStorage.setItem('theme', mode); } catch (e) {}
        syncThemeIcons();
      }

      function clampTooltip(trigger: HTMLElement) {
        const bubble = trigger.querySelector<HTMLElement>('.tooltip-bubble');
        if (!bubble) return;
        bubble.style.setProperty('--tip-shift', '0px');
        const margin = 12;
        const triggerRect = trigger.getBoundingClientRect();
        const bubbleRect = bubble.getBoundingClientRect();
        const center = triggerRect.left + triggerRect.width / 2;
        const half = bubbleRect.width / 2;
        const vw = document.documentElement.clientWidth;
        let shift = 0;
        if (center - half < margin) shift = margin - (center - half);
        else if (center + half > vw - margin) shift = (vw - margin) - (center + half);
        bubble.style.setProperty('--tip-shift', shift + 'px');
      }

      function setMenuOpen(open: boolean) {
        const menu = document.getElementById('mobile-menu');
        const toggle = document.getElementById('mobile-menu-toggle');
        if (!menu || !toggle) return;
        menu.setAttribute('data-open', String(open));
        toggle.setAttribute('aria-expanded', String(open));
        toggle.querySelector<HTMLElement>('.menu-icon-closed')?.classList.toggle('hidden', open);
        toggle.querySelector<HTMLElement>('.menu-icon-open')?.classList.toggle('hidden', !open);
      }

      function initPage() {
        syncThemeIcons();

        document.querySelectorAll<HTMLElement>('#theme-toggle, #theme-toggle-desktop').forEach(btn => {
          const fresh = btn.cloneNode(true) as HTMLElement;
          btn.parentNode!.replaceChild(fresh, btn);
          fresh.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            setTheme(current === 'dark' ? 'light' : 'dark');
          });
        });

        const menuToggle = document.getElementById('mobile-menu-toggle');
        if (menuToggle) {
          const fresh = menuToggle.cloneNode(true) as HTMLElement;
          menuToggle.parentNode!.replaceChild(fresh, menuToggle);
          fresh.addEventListener('click', () => {
            const menu = document.getElementById('mobile-menu');
            const isOpen = menu?.getAttribute('data-open') === 'true';
            setMenuOpen(!isOpen);
          });
        }

        document.querySelectorAll<HTMLAnchorElement>('#mobile-menu a').forEach(link => {
          link.addEventListener('click', () => setMenuOpen(false));
        });

        document.querySelectorAll<HTMLElement>('.tooltip-trigger').forEach(trigger => {
          const handler = () => clampTooltip(trigger);
          trigger.addEventListener('pointerenter', handler);
          trigger.addEventListener('focusin', handler);
          trigger.addEventListener('touchstart', handler, { passive: true });
        });
      }

      if (!(window as any).__menuEscBound) {
        (window as any).__menuEscBound = true;
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setMenuOpen(false);
        });
      }

      document.addEventListener('astro:page-load', initPage);

      document.addEventListener('astro:after-swap', () => {
        const theme = document.documentElement.getAttribute('data-theme')
          || (() => { try { return localStorage.getItem('theme'); } catch (e) { return null; } })()
          || 'light';
        document.documentElement.setAttribute('data-theme', theme);
        syncThemeIcons();
      });

    </script>
  </body>
</html>
