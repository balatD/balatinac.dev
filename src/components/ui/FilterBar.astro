---
import { t } from '../../lib/i18n';
import type { Lang } from '../../lib/i18n';

interface Props {
  tags: string[];
  total: number;
  lang: Lang;
}

const { tags, total, lang } = Astro.props;
const padded = String(total).padStart(2, '0');
---

<div data-filters class="flex flex-wrap items-center justify-between gap-x-6 gap-y-4">
  <div class="flex flex-wrap gap-2" role="group" aria-label={t('filter.label', lang)}>
    <button type="button" data-tag="all" aria-pressed="true" class="chip">{t('filter.all', lang)}</button>
    {tags.map((tag) => (
      <button type="button" data-tag={tag.toLowerCase()} aria-pressed="false" class="chip">{tag}</button>
    ))}
  </div>
  <span id="count" class="font-mono text-[13px] text-muted" aria-live="polite">{padded} / {padded}</span>
</div>

<script>
  function initFilters() {
    const filterRoot = document.querySelector('[data-filters]');
    if (!filterRoot) return;
    const list = document.getElementById('list');
    const countEl = document.getElementById('count');
    if (!list) return;
    const items = [...list.querySelectorAll('li')];
    const buttons = [...filterRoot.querySelectorAll('button[data-tag]')] as HTMLButtonElement[];

    const total = items.length;
    function setCount(shown: number) {
      if (!countEl) return;
      countEl.textContent =
        String(shown).padStart(2, '0') + ' / ' + String(total).padStart(2, '0');
    }

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));

        const tag = btn.dataset.tag;
        let shown = 0;
        items.forEach((li) => {
          const tags = (li.dataset.tags || '').split(',');
          const visible = tag === 'all' || tags.includes(tag!);
          (li as HTMLElement).style.display = visible ? '' : 'none';
          if (visible) shown++;
        });
        setCount(shown);
      });
    });

    setCount(total);
  }

  function activateTagFromURL() {
    const params = new URLSearchParams(window.location.search);
    const tag = params.get('tag');
    if (!tag) return;
    const btn = document.querySelector(`button[data-tag="${tag}"]`) as HTMLButtonElement | null;
    if (btn) btn.click();
  }

  document.addEventListener('astro:page-load', () => {
    initFilters();
    activateTagFromURL();
  });
</script>
