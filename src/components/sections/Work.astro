---
import { getCollection } from 'astro:content';
import { buildDeMap, getLocalizedEntry } from '../../lib/content-helpers';
import type { Lang } from '../../lib/i18n';
import { t, langPrefix } from '../../lib/i18n';
import Card from '../ui/Card.astro';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
const prefix = langPrefix(lang);

const enProjects = await getCollection('projects');
const deProjects = await getCollection('projectsDe');
const projects = enProjects.sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const deMap = buildDeMap(deProjects);
const hasProjects = projects.length > 0;
---

<section id="work" class="section mx-auto max-w-wrap px-5 sm:px-8 md:px-10" aria-labelledby="work-title" data-reveal-group>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <h2 id="work-title" class="h2-section m-0" data-reveal>{t('work.label', lang)}</h2>
    <a class="link-accent text-[15px] font-medium py-3" href={`${prefix}/work/`} data-reveal>{t('work.all', lang)}</a>
  </div>
  {hasProjects ? (
    <ul class="card-grid mt-9">
      {projects.map((project) => {
        const { title, description, slug } = getLocalizedEntry(project, deMap, lang);
        const status = (lang === 'de' && deMap.get(project.id)?.data.meta?.status) || project.data.meta?.status;
        return (
          <Card
            href={`${prefix}/work/${slug}/`}
            title={title}
            description={description}
            meta={status ? `${project.data.year} · ${status}` : String(project.data.year)}
          />
        );
      })}
    </ul>
  ) : (
    <p class="text-[17px] text-muted mt-9" data-reveal>{t('empty.work', lang)}</p>
  )}
</section>
