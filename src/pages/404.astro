---
import BaseLayout from '../layouts/BaseLayout.astro';
import AsciiArt from '../components/ui/AsciiArt.astro';
import { t } from '../lib/i18n';

const lang = 'de';
export const prerender = true;
---

<!-- altLangUrl is pinned to the EN home: Astro serves one 404 for the whole
     site, so the default /en/404/ swap would land on another 404. -->
<BaseLayout title={t('title.404', lang)} description="Seite nicht gefunden." noindex={true} lang={lang} altLangUrl="/en/">
  <section class="page-intro page-intro--art" aria-labelledby="page-title">
    <AsciiArt slot="figure" lang={lang} class="ascii-cover--side" />
    <div class="page-intro__copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10" data-reveal-group>
      <h1 id="page-title" class="h1-page m-0 max-w-[12ch]" data-reveal>{t('404.heading', lang)}</h1>
      <p class="lead text-muted mt-6 mb-0 max-w-[40ch] text-pretty" data-reveal>{t('404.sub', lang)}</p>
      <ul class="list-none p-0 mt-8 mb-0 flex flex-wrap items-center gap-3" data-reveal>
        <li><a class="link-accent inline-flex items-center min-h-11 pr-3 text-[18px] font-medium" href="/">{t('404.home', lang)}</a></li>
        <li><a class="pill" href="/work/">{t('404.work', lang)}</a></li>
        <li><a class="pill" href="/blog/">{t('404.writing', lang)}</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
