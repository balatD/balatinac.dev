---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AsciiArt from '../../components/ui/AsciiArt.astro';
import Card from '../../components/ui/Card.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import FilterBar from '../../components/ui/FilterBar.astro';
import { getCollection } from 'astro:content';
import { buildDeMap, getLocalizedEntry } from '../../lib/content-helpers';
import { t, dateLocale } from '../../lib/i18n';

const lang = 'de';
export const prerender = true;

const enPosts = await getCollection('blog');
const dePosts = await getCollection('blogDe');
const sorted = enPosts.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const deMap = buildDeMap(dePosts);
const hasPosts = sorted.length > 0;
const allTags = [...new Set(sorted.flatMap((p) => p.data.tags))].sort();
---

<BaseLayout title={t('title.blog', lang)} description={t('blogIndex.sub', lang)} activeNav="writing" lang={lang}>
  <section class="page-intro page-intro--art" aria-labelledby="page-title">
    <AsciiArt slot="figure" lang={lang} class="ascii-cover--side" />
    <Breadcrumbs items={[
      { label: t('crumb.home', lang), href: '/' },
      { label: t('blogIndex.crumb', lang) },
    ]} />
    <div class="page-intro__copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10" data-reveal-group>
      <div class="max-w-[760px]">
        <h1 id="page-title" class="h1-page m-0 max-w-[14ch]" data-reveal set:html={t('blogIndex.heading', lang)} />
        <p class="lead text-muted mt-6 mb-0 max-w-[48ch] text-pretty" data-reveal>{t('blogIndex.sub', lang)}</p>
      </div>
    </div>
  </section>

  {hasPosts ? (
    <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 pt-10 pb-[clamp(72px,9vw,128px)]">
      <FilterBar tags={allTags} total={sorted.length} lang={lang} />
      <ul id="list" class="card-grid card-grid--wide mt-8">
        {sorted.map((post) => {
          const { title, description, slug } = getLocalizedEntry(post, deMap, lang);
          const dateStr = post.data.publishedAt.toLocaleDateString(dateLocale(lang), { month: 'short', year: 'numeric' });
          const readTime = deMap.get(post.id)?.data.readTime || post.data.readTime;
          return (
            <Card
              href={`/blog/${slug}/`}
              title={title}
              description={description}
              meta={readTime ? `${dateStr} · ${readTime}` : dateStr}
              tags={post.data.tags.join(',')}
              draftLabel={post.data.draft ? t('blogIndex.draft', lang) : undefined}
            />
          );
        })}
      </ul>
    </div>
  ) : (
    <section class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 py-16 md:py-24 text-center">
      <p class="text-[17px] text-muted">{t('empty.blog', lang)}</p>
    </section>
  )}
</BaseLayout>
