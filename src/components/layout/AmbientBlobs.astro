<div class="ambient-blobs" aria-hidden="true">
  <div class="blob a"></div>
  <div class="blob b"></div>
  <div class="blob c"></div>
</div>

<style>
  .ambient-blobs {
    position: fixed;
    inset: 0;
    z-index: -10;
    pointer-events: none;
    overflow: hidden;
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    will-change: transform;
    transform: translateZ(0);
    backface-visibility: hidden;
  }

  .blob.a {
    width: 53vmax;
    height: 43vmax;
    left: -8vmax;
    top: -8vmax;
    background: var(--accent);
    opacity: 0.05;
  }

  .blob.b {
    width: 60vmax;
    height: 47vmax;
    right: -10vmax;
    top: 10vmax;
    background: var(--fg);
    opacity: 0.04;
  }

  .blob.c {
    width: 70vmax;
    height: 40vmax;
    left: 18vmax;
    bottom: -12vmax;
    background: var(--accent);
    opacity: 0.035;
  }
</style>
