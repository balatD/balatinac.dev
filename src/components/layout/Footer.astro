---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
---

<footer class="relative border-t-2 border-rule overflow-hidden" style="background-image: linear-gradient(to bottom, transparent 0%, var(--bg) 24%);">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 pt-10 pb-10 flex justify-between items-center flex-wrap gap-3 font-mono text-[12px] sm:text-[13px] text-muted">
    <span>&copy; {new Date().getFullYear()} Dragan Balatinac</span>
    <span>{t('footer.built', lang)}</span>
  </div>

  <!-- Oversized brand wordmark — full-bleed footer graphic -->
  <div class="footer-wordmark-wrap" aria-hidden="true">
    <span class="footer-wordmark">dragan<span class="wordmark-dot">.</span></span>
  </div>
</footer>
