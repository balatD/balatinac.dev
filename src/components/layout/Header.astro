---
import type { Lang } from '../../lib/i18n';
import { t, langPrefix, langSwitchUrl } from '../../lib/i18n';

interface Props {
  activeNav?: 'about' | 'work' | 'writing' | 'contact';
  lang?: Lang;
  altLangUrl?: string;
}

const { activeNav, lang = 'de', altLangUrl } = Astro.props;
const prefix = langPrefix(lang);
const altLang = lang === 'de' ? 'en' : 'de';
const altUrl = altLangUrl || langSwitchUrl(Astro.url.pathname, lang);

const navLinks = [
  { href: `${prefix}/#about`, label: t('nav.about', lang), id: 'about' },
  { href: `${prefix}/work/`, label: t('nav.work', lang), id: 'work' },
  { href: `${prefix}/blog/`, label: t('nav.writing', lang), id: 'writing' },
  { href: `${prefix}/#contact`, label: t('nav.contact', lang), id: 'contact' },
];
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 backdrop-blur-[16px]" style="background: color-mix(in oklab, var(--bg) 75%, transparent);">
  <!-- Mobile -->
  <div class="flex md:hidden items-center justify-between h-12 px-5 sm:px-7">
    <a href={`${prefix}/`} aria-label="Dragan Balatinac — home" class="wordmark font-sans text-[15px] font-medium tracking-[-0.02em] leading-none text-fg">d<span class="wordmark-dot">.</span></a>
    <div class="flex items-center">
      <nav id="nav-links" class="flex items-center font-mono text-[11px] uppercase tracking-[0.08em]" aria-label="Primary">
        {navLinks.map((link) => (
          <a class:list={['nav-link px-2.5 py-2 transition-colors duration-200', activeNav === link.id ? 'text-fg active' : 'text-muted hover:text-fg']} href={link.href} aria-current={activeNav === link.id ? 'page' : undefined}>{link.label}</a>
        ))}
      </nav>
      <a href={altUrl} class="inline-flex items-center justify-center w-8 h-8 font-mono text-[11px] tracking-[0.1em] text-muted hover:text-fg transition-colors" aria-label={altLang === 'en' ? 'Switch to English' : 'Auf Deutsch wechseln'}>{altLang.toUpperCase()}</a>
      <button id="theme-toggle" class="inline-flex items-center justify-center w-8 h-8 text-muted hover:text-fg cursor-pointer transition-colors" aria-label="Toggle theme">
        <svg id="icon-sun" class="w-[14px] h-[14px] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
        <svg id="icon-moon" class="w-[14px] h-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
    </div>
  </div>

  <!-- Desktop -->
  <div class="hidden md:block h-14">
    <div class="mx-auto max-w-wrap px-8 h-full flex items-center justify-between">
      <!-- Wordmark + nav together -->
      <div class="flex items-center">
        <a
          href={`${prefix}/`}
          aria-label="Dragan Balatinac — home"
          class="wordmark font-sans text-[17px] font-medium tracking-[-0.02em] leading-none text-fg mr-8"
        >dragan<span class="wordmark-dot">.</span></a>

        <nav id="nav-links-desktop" class="flex items-center font-mono text-[12px] uppercase tracking-[0.08em]" aria-label="Primary">
          {navLinks.map((link) => (
            <a
              class:list={[
                'nav-link px-4 py-2 transition-colors duration-200',
                activeNav === link.id ? 'text-fg active' : 'text-muted hover:text-fg',
              ]}
              href={link.href}
              aria-current={activeNav === link.id ? 'page' : undefined}
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Controls -->
      <div class="flex items-center">
        <a href={altUrl} class="inline-flex items-center justify-center w-8 h-8 font-mono text-[11px] tracking-[0.1em] text-muted hover:text-fg transition-colors" aria-label={altLang === 'en' ? 'Switch to English' : 'Auf Deutsch wechseln'}>{altLang.toUpperCase()}</a>
        <button id="theme-toggle-desktop" class="inline-flex items-center justify-center w-8 h-8 text-muted hover:text-fg cursor-pointer transition-colors" aria-label="Toggle theme">
          <svg class="icon-sun w-[14px] h-[14px] hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
          <svg class="icon-moon w-[14px] h-[14px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
      </div>
    </div>
  </div>
</header>
