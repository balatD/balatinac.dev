---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../lib/i18n';

const lang = 'de';
export const prerender = true;
---

<BaseLayout title={t('title.404', lang)} description="Seite nicht gefunden." noindex={true} lang={lang}>
  <section class="pt-[140px] pb-20 sm:pt-[160px] sm:pb-24 md:pt-[200px] md:pb-[140px]">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
      <p class="font-mono text-[13px] text-accent m-0 mb-6">404</p>
      <h1 class="h1-page leading-[1.1] m-0 mb-5 text-balance">{t('404.heading', lang)}</h1>
      <p class="text-[18px] leading-[1.6] text-muted m-0 mb-8 text-pretty">{t('404.sub', lang)}</p>
      <div class="flex flex-wrap gap-x-6 gap-y-4 font-mono text-[14px]">
        <a class="cta-link inline-flex items-center gap-2 pb-1 text-fg border-b border-fg hover:text-accent hover:border-accent" href="/">{t('404.home', lang)}</a>
        <a class="cta-link inline-flex items-center gap-2 pb-1 text-muted border-b border-rule hover:text-accent hover:border-accent" href="/work/">{t('404.work', lang)}</a>
        <a class="cta-link inline-flex items-center gap-2 pb-1 text-muted border-b border-rule hover:text-accent hover:border-accent" href="/blog/">{t('404.writing', lang)}</a>
      </div>
    </div>
  </section>
</BaseLayout>
