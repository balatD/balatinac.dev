---
import type { Lang } from '../../lib/i18n';
import { t, langPrefix } from '../../lib/i18n';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
const prefix = langPrefix(lang);
---

<section class="relative pt-[140px] pb-20 sm:pt-[160px] sm:pb-24 md:pt-[200px] md:pb-[140px]">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
    <p class="tick inline-flex items-center gap-2.5 m-0 mb-6 sm:mb-7 font-mono text-[13px] tracking-wide text-accent">
      {t('hero.greeting', lang)}
    </p>
    <h1 class="h1-hero font-medium leading-[1.05] tracking-[-0.035em] m-0 mb-7 sm:mb-8 text-balance text-fg" set:html={t('hero.heading', lang)} />
    <p class="text-[18px] sm:text-[19px] leading-[1.55] text-muted m-0 mb-8 sm:mb-9 max-w-[56ch] text-pretty">
      {t('hero.sub', lang)}
    </p>
    <div class="flex flex-wrap gap-x-6 gap-y-4 font-mono text-[14px]">
      <a class="cta-link inline-flex items-center gap-2 pb-1 text-fg border-b border-fg hover:text-accent hover:border-accent" href={`${prefix}/#work`}>{t('hero.cta.work', lang)}</a>
      <a class="cta-link inline-flex items-center gap-2 pb-1 text-muted border-b border-rule hover:text-accent hover:border-accent" href={`${prefix}/#writing`}>{t('hero.cta.notes', lang)}</a>
    </div>
  </div>
</section>
