---
import { getCollection } from 'astro:content';
import { buildDeMap, getLocalizedEntry } from '../../lib/content-helpers';
import type { Lang } from '../../lib/i18n';
import { t, langPrefix } from '../../lib/i18n';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
const prefix = langPrefix(lang);

const enPosts = await getCollection('blog');
const dePosts = await getCollection('blogDe');
const posts = enPosts
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);
const deMap = buildDeMap(dePosts);
const hasPosts = posts.length > 0;
---

<section id="writing" class="py-14 sm:py-16 md:py-20 border-t border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
    <p class="section-label font-mono text-[13px] text-muted m-0 mb-7 md:mb-8">{t('writing.label', lang)}</p>
    {hasPosts ? (
      <>
        <ul class="list-none p-0 m-0 divide-y divide-rule">
          {posts.map((post) => {
            const { title, description, slug } = getLocalizedEntry(post, deMap, lang);
            const dateStr = post.data.publishedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
            return (
              <li>
                <a class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1 sm:gap-6 sm:items-baseline py-5 hover:text-accent transition-colors group" href={`${prefix}/blog/${slug}/`}>
                  <div>
                    <div class="text-[17px] font-medium leading-snug text-balance">{title}</div>
                    <div class="text-[14px] sm:text-[15px] text-muted mt-1 text-pretty">{description}</div>
                  </div>
                  <div class="font-mono text-[12px] sm:text-[13px] text-muted whitespace-nowrap group-hover:text-accent transition-colors">{dateStr}</div>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="mt-7 font-mono text-[13px]">
          <a class="text-muted hover:text-accent after:content-['_→']" href={`${prefix}/blog/`}>{t('writing.all', lang)}</a>
        </p>
      </>
    ) : (
      <p class="text-[17px] text-muted">{t('empty.blog', lang)}</p>
    )}
  </div>
</section>
