---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
---

<section id="about" class="py-14 sm:py-16 md:py-20 border-t border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
    <p class="section-label font-mono text-[13px] text-muted m-0 mb-7 md:mb-8">{t('about.label', lang)}</p>
    <p class="text-[17px] leading-[1.7] text-fg max-w-[60ch] text-pretty m-0 mb-[18px]" set:html={t('about.p1', lang)} />
    <p class="text-[17px] leading-[1.7] text-fg max-w-[60ch] text-pretty m-0 mb-[18px]" set:html={t('about.p2', lang)} />
    <p class="text-[17px] leading-[1.7] text-fg max-w-[60ch] text-pretty m-0 mb-[18px]" set:html={t('about.p3', lang)} />
    <p class="text-[17px] leading-[1.7] text-muted max-w-[60ch] text-pretty m-0" set:html={t('about.p4', lang)} />
  </div>
</section>
