---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';
import AsciiArt from '../ui/AsciiArt.astro';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title" data-reveal-group data-hero>
  <AsciiArt slot="hero" lang={lang} class="ascii-cover--hero" />
  <div class="hero-copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10">
    <h1 id="hero-title" class="h1-display m-0" data-reveal>{t('hero.title', lang)}<span class="text-accent">.</span></h1>
    <p class="lead mt-7 mb-0 max-w-[42ch] text-pretty" data-reveal set:html={t('hero.sub', lang)} />
  </div>
</section>
