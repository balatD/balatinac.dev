---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';

interface Props {
  lang?: Lang;
}

const { lang = 'de' } = Astro.props;
---

<footer class="border-t border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 py-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-[14px] text-muted">
    <span>&copy; {new Date().getFullYear()} Dragan Balatinac · {t('footer.built', lang)}</span>
    <a class="py-3 text-fg hover:text-accent transition-colors" href="#main">{t('footer.top', lang)}</a>
  </div>
</footer>
