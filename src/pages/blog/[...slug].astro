---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import JsonLd from '../../components/layout/JsonLd.astro';
import { getCollection, render } from 'astro:content';
import { getEnEntries, getDeMap } from '../../lib/content-helpers';

export async function getStaticPaths() {
  const all = await getCollection('blog');
  const en = all.filter((p) => !p.id.startsWith('de/'));
  return en.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const all = await getCollection('blog');
const allEn = getEnEntries(all).sort(
  (a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const deMap = getDeMap(all);
const de = deMap.get(post.id);

let DeContent: any = null;
if (de) {
  const rendered = await render(de);
  DeContent = rendered.Content;
}

const currentIndex = allEn.findIndex((p) => p.id === post.id);
const nextPost = allEn[currentIndex + 1] || null;
const nextDe = nextPost ? deMap.get(nextPost.id) : undefined;

const pubDate = post.data.publishedAt;
const dateStr = pubDate.toLocaleDateString('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  activeNav="writing"
  ogType="article"
  publishedAt={post.data.publishedAt}
>
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    author: { '@type': 'Person', name: 'Dragan Balatinac' },
    url: new URL(Astro.url.pathname, Astro.site).toString(),
  }} />

  <meta name="i18n-title" content="__de-direct__" data-de={de ? `${de.data.title} — Dragan Balatinac` : undefined} data-en={`${post.data.title} — Dragan Balatinac`} />

  <Breadcrumbs items={[
    { label: 'Home', href: '/', i18n: 'crumb.home' },
    { label: 'Writing', href: '/blog/', i18n: 'crumb.writing' },
    { label: post.data.title },
  ]} />

  <header class="pt-12 pb-12 sm:pt-14 sm:pb-14 md:pt-14 md:pb-[60px]">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
      <p class="font-mono text-[13px] text-muted m-0 mb-5">{dateStr} · {post.data.readTime || '~5 min read'}</p>
      <h1 class="h1-page font-medium leading-[1.15] tracking-[-0.02em] m-0 mb-5 text-balance" data-de={de?.data.title}>{post.data.title}</h1>
    </div>
  </header>

  <section class="py-3 border-y border-rule font-mono text-[13px] text-muted">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 flex flex-wrap gap-x-6 gap-y-2">
      <span><span data-i18n="meta.published">Published</span><strong class="text-fg font-sans font-medium ml-1.5">{dateStr}</strong></span>
      <span><span data-i18n="meta.readTime">Read time</span><strong class="text-fg font-sans font-medium ml-1.5" data-de={de?.data.readTime}>{post.data.readTime || '~5 min'}</strong></span>
      <span class="flex gap-2.5 sm:ml-auto">
        {post.data.tags.map((tag) => (
          <span class="text-muted before:content-['#'] before:text-accent">{tag}</span>
        ))}
      </span>
    </div>
  </section>

  <article class="py-12 sm:py-14 md:py-14 pb-16 md:pb-20">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 [&>*]:max-w-[64ch] prose-article" data-lang-content="en">
      <Content />
    </div>
    {DeContent && (
      <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 [&>*]:max-w-[64ch] prose-article hidden" data-lang-content="de">
        <DeContent />
      </div>
    )}
  </article>

  <nav class="border-t border-rule">
    <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8 grid grid-cols-1 sm:grid-cols-2">
      <a class="py-7 pr-4 hover:text-accent transition-colors" href="/blog/">
        <div class="font-mono text-[12px] text-muted mb-1.5" data-i18n="blog.backToWriting">← Back to writing</div>
        <div class="text-[16px] font-medium" data-i18n="blog.allPosts">All posts</div>
      </a>
      {nextPost && (
        <a class="py-7 pl-4 text-right border-t sm:border-t-0 sm:border-l border-rule hover:text-accent transition-colors" href={`/blog/${nextPost.id}/`}>
          <div class="font-mono text-[12px] text-muted mb-1.5" data-i18n="blog.nextPost">Next post</div>
          <div class="text-[16px] font-medium" data-de={nextDe ? `${nextDe.data.title} →` : undefined}>{nextPost.data.title} →</div>
        </a>
      )}
    </div>
  </nav>
</BaseLayout>

<style>
  .prose-article :global(h2) { font-weight: 500; font-size: 26px; line-height: 1.25; letter-spacing: -0.015em; margin-top: 48px; margin-bottom: 16px; }
  .prose-article :global(h3) { font-weight: 500; font-size: 18px; margin-top: 28px; margin-bottom: 8px; }
  .prose-article :global(p) { font-size: 17px; line-height: 1.75; margin: 0 0 16px; text-wrap: pretty; }
  .prose-article :global(ul), .prose-article :global(ol) { list-style: none; padding: 0; margin: 0 0 22px; counter-reset: ord; }
  .prose-article :global(li) { position: relative; padding: 8px 0 8px 26px; font-size: 17px; line-height: 1.65; border-bottom: 1px solid var(--rule); }
  .prose-article :global(li:first-child) { border-top: 1px solid var(--rule); }
  .prose-article :global(ul li::before) { content: "—"; position: absolute; left: 0; color: var(--accent); }
  .prose-article :global(ol li) { counter-increment: ord; }
  .prose-article :global(ol li::before) { content: counter(ord, decimal-leading-zero); position: absolute; left: 0; color: var(--accent); font-family: "Space Mono", monospace; font-size: 13px; top: 10px; }
  .prose-article :global(blockquote) { border-left: 2px solid var(--accent); padding: 4px 0 4px 18px; margin: 28px 0; font-size: 19px; line-height: 1.45; font-style: italic; }
  .prose-article :global(blockquote p) { font-size: inherit; line-height: inherit; margin: 0; }
  .prose-article :global(pre) { padding: 20px 24px; margin: 0 0 24px; font-size: 13px; line-height: 1.65; border-radius: 6px; overflow-x: auto; white-space: pre; }
  .prose-article :global(pre code) { font-family: "Space Mono", monospace; background: none; padding: 0; font-size: inherit; }
  .prose-article :global(hr) { border: 0; border-top: 1px solid var(--rule); margin: 56px 0; }
  .prose-article :global(a) { color: var(--fg); border-bottom: 1px solid var(--muted); transition: color 0.15s, border-color 0.15s; }
  .prose-article :global(a:hover) { color: var(--accent); border-color: var(--accent); }
  .prose-article :global(em:last-child) { display: block; font-family: "Space Mono", monospace; font-size: 13px; color: var(--muted); margin-top: 40px; font-style: normal; }
</style>
