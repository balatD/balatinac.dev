---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
---

<section id="about" class="section mx-auto max-w-wrap px-5 sm:px-8 md:px-10" aria-labelledby="about-title" data-reveal-group>
  <div class="max-w-[880px]">
    <h2 id="about-title" class="h2-section m-0" data-reveal>{t('about.label', lang)}</h2>
    <p class="text-[clamp(20px,1.7vw,23px)] leading-[1.45] mt-7 mb-0 text-pretty" data-reveal set:html={t('about.p1', lang)} />
    <div class="mt-6 max-w-[62ch] text-muted flex flex-col gap-4">
      <p class="m-0 text-pretty" data-reveal set:html={t('about.p2', lang)} />
      <p class="m-0 text-pretty" data-reveal set:html={t('about.p3', lang)} />
      <p class="m-0 text-pretty" data-reveal set:html={t('about.p4', lang)} />
    </div>
  </div>
</section>
