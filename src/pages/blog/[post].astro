---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AsciiArt from '../../components/ui/AsciiArt.astro';
import Card from '../../components/ui/Card.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import JsonLd from '../../components/layout/JsonLd.astro';
import { getCollection, render } from 'astro:content';
import { buildDeMap } from '../../lib/content-helpers';
import { t } from '../../lib/i18n';

const lang = 'de';
export const prerender = true;

export async function getStaticPaths() {
  const en = await getCollection('blog');
  const deEntries = await getCollection('blogDe');
  const deMap = buildDeMap(deEntries);
  return en.map((post) => {
    const de = deMap.get(post.id);
    const deSlug = de?.data.urlSlug || post.id;
    return { params: { post: deSlug }, props: { post } };
  });
}

const { post } = Astro.props;

const allEn = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const dePosts = await getCollection('blogDe');
const deMap = buildDeMap(dePosts);
const de = deMap.get(post.id);

const contentEntry = de || post;
const { Content } = await render(contentEntry);
const displayTitle = de?.data.title || post.data.title;
const displayDesc = de?.data.description || post.data.description;
const displayReadTime = de?.data.readTime || post.data.readTime || '~5 Min.';

const currentIndex = allEn.findIndex((p) => p.id === post.id);
const nextPost = allEn[currentIndex + 1] || null;
const nextDe = nextPost ? deMap.get(nextPost.id) : undefined;
const nextSlug = nextDe?.data.urlSlug || nextPost?.id;

const dateStr = post.data.publishedAt.toLocaleDateString('de-DE', { day: 'numeric', month: 'short', year: 'numeric' });
const altLangUrl = `/en/blog/${post.id}/`;
const relatedPosts = allEn
  .filter((p) => p.id !== post.id && p.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);
const relatedDe = relatedPosts.map((p) => deMap.get(p.id));
const relatedSlugs = relatedPosts.map((p, i) => relatedDe[i]?.data.urlSlug || p.id);
---

<BaseLayout title={displayTitle} description={displayDesc} activeNav="writing" ogType="article" publishedAt={post.data.publishedAt} lang={lang} altLangUrl={altLangUrl}>
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: displayTitle,
    description: displayDesc,
    datePublished: post.data.publishedAt.toISOString(),
    author: { '@type': 'Person', name: 'Dragan Balatinac', url: 'https://balatinac.dev' },
    publisher: { '@type': 'Person', name: 'Dragan Balatinac' },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    url: new URL(Astro.url.pathname, Astro.site).toString(),
  }} />
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://balatinac.dev/' },
      { '@type': 'ListItem', position: 2, name: 'Texte', item: 'https://balatinac.dev/blog/' },
      { '@type': 'ListItem', position: 3, name: displayTitle },
    ],
  }} />

  <header class="page-intro page-intro--art">
    <AsciiArt slot="band" lang={lang} class="ascii-cover--band" />
    <Breadcrumbs items={[
      { label: t('crumb.home', lang), href: '/' },
      { label: t('crumb.writing', lang), href: '/blog/' },
      { label: displayTitle },
    ]} />
    <div class="page-intro__copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10" data-reveal-group>
      <h1 class="h1-page m-0 max-w-[20ch]" data-reveal>{displayTitle}</h1>
      <p class="lead text-muted mt-6 mb-0 max-w-[56ch] text-pretty" data-reveal>{displayDesc}</p>
    </div>
  </header>

  <div class="meta-bar">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 flex flex-wrap items-center gap-x-8">
      <dl>
        <div><dt>{t('meta.published', lang)}</dt><dd>{dateStr}</dd></div>
        <div><dt>{t('meta.readTime', lang)}</dt><dd>{displayReadTime}</dd></div>
      </dl>
      <ul class="tag-list" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <li><a href={`/blog/?tag=${tag.toLowerCase()}`}><span class="text-accent" aria-hidden="true">#</span>{tag}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <article class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 pt-[clamp(48px,6vw,80px)] pb-[clamp(72px,9vw,112px)]">
    <div class="prose-article">
      <Content />
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="border-t border-rule" aria-labelledby="related-title">
      <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 py-[clamp(48px,6vw,72px)]">
        <h2 id="related-title" class="h3-section m-0">{t('blog.relatedPosts', lang)}</h2>
        <ul class="card-grid card-grid--wide mt-7">
          {relatedPosts.map((rp, i) => (
            <Card
              href={`/blog/${relatedSlugs[i]}/`}
              title={relatedDe[i]?.data.title || rp.data.title}
              description={relatedDe[i]?.data.description || rp.data.description}
              meta={rp.data.publishedAt.toLocaleDateString('de-DE', { month: 'short', year: 'numeric' })}
            />
          ))}
        </ul>
      </div>
    </section>
  )}

  <nav class="border-t border-rule" aria-label="Beitragsnavigation">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 grid grid-cols-1 sm:grid-cols-2">
      <a class="post-nav" href="/blog/">
        <span class="block text-[14px] text-muted">{t('blog.backToWriting', lang)}</span>
        <span class="post-nav__title">{t('blog.allPosts', lang)}</span>
      </a>
      {nextPost && (
        <a class="post-nav post-nav--next" href={`/blog/${nextSlug}/`}>
          <span class="block text-[14px] text-muted">{t('blog.nextPost', lang)} →</span>
          <span class="post-nav__title">{nextDe?.data.title || nextPost.data.title}</span>
        </a>
      )}
    </div>
  </nav>
</BaseLayout>
