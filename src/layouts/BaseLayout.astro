---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Wordmark from '../components/layout/Wordmark.astro';
import AmbientBlobs from '../components/layout/AmbientBlobs.astro';
import SEO from '../components/layout/SEO.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedAt?: Date;
  noindex?: boolean;
  activeNav?: 'about' | 'work' | 'writing' | 'contact';
}

const {
  title,
  description = 'Portfolio of Dragan Balatinac — backend engineer building quiet, reliable systems.',
  ogImage,
  ogType,
  publishedAt,
  noindex,
  activeNav,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SEO
      title={title}
      description={description}
      ogImage={ogImage}
      ogType={ogType}
      publishedAt={publishedAt}
      noindex={noindex}
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
    />

    <link rel="alternate" type="application/rss+xml" title="Dragan Balatinac RSS" href="/rss.xml" />

    <ClientRouter />

    <meta name="generator" content={Astro.generator} />

    <!-- Inline: restore theme + lang before paint (runs on every navigation) -->
    <script is:inline>
      (function () {
        var theme = null;
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (!theme) {
          theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body class="bg-bg text-fg font-sans antialiased leading-relaxed text-[17px]">
    <a
      href="#main"
      class="skip-link"
      data-i18n="skip"
    >
      Skip to content
    </a>

    <AmbientBlobs />

    <Wordmark />
    <Header activeNav={activeNav} />

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <!-- Main interactive script: uses astro:page-load to re-bind after each navigation -->
    <script>
      import { translations } from '../lib/i18n';

      // ── Theme ──────────────────────────────────────────────
      function syncThemeIcons() {
        const theme = document.documentElement.getAttribute('data-theme') || 'light';
        const sun = document.getElementById('icon-sun');
        const moon = document.getElementById('icon-moon');
        if (sun) sun.style.display = theme === 'dark' ? 'block' : 'none';
        if (moon) moon.style.display = theme === 'dark' ? 'none' : 'block';
      }

      function setTheme(mode: string) {
        document.documentElement.setAttribute('data-theme', mode);
        try { localStorage.setItem('theme', mode); } catch (e) {}
        syncThemeIcons();
      }

      // ── i18n ───────────────────────────────────────────────
      function getLang(): string {
        try { return localStorage.getItem('lang') || 'en'; } catch (e) { return 'en'; }
      }

      function setLang(lang: string) {
        try { localStorage.setItem('lang', lang); } catch (e) {}
        document.documentElement.setAttribute('lang', lang === 'de' ? 'de' : 'en');
        applyTranslations(lang);
        syncLangButton(lang);
      }

      function applyTranslations(lang: string) {
        // data-i18n: UI strings via key lookup (textContent)
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.dataset.i18n!;
          const entry = translations[key];
          if (entry && entry[lang]) {
            el.textContent = entry[lang];
          }
        });
        // data-i18n-html: UI strings via key lookup (innerHTML)
        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
          const key = el.dataset.i18nHtml!;
          const entry = translations[key];
          if (entry && entry[lang]) {
            el.innerHTML = entry[lang];
          }
        });
        // data-de: content translations from MD files (textContent)
        document.querySelectorAll<HTMLElement>('[data-de]').forEach((el) => {
          if (!el.dataset.en) el.dataset.en = el.textContent || '';
          el.textContent = lang === 'de' ? (el.dataset.de || el.dataset.en || '') : (el.dataset.en || '');
        });
        // data-lang-content: swap full article body between EN and DE
        document.querySelectorAll<HTMLElement>('[data-lang-content]').forEach((el) => {
          const contentLang = el.dataset.langContent;
          if (contentLang === lang) {
            el.classList.remove('hidden');
          } else {
            el.classList.add('hidden');
          }
        });
        // Translate document.title
        const titleMeta = document.querySelector<HTMLMetaElement>('meta[name="i18n-title"]');
        if (titleMeta) {
          const key = titleMeta.content;
          if (key === '__de-direct__') {
            // Title comes directly from data-de/data-en attributes (detail pages)
            if (!titleMeta.dataset.enSaved) titleMeta.dataset.enSaved = titleMeta.dataset.en || document.title;
            document.title = lang === 'de'
              ? (titleMeta.dataset.de || titleMeta.dataset.enSaved || document.title)
              : (titleMeta.dataset.enSaved || document.title);
          } else {
            // Title comes from i18n translations object (index pages)
            const entry = translations[key];
            if (entry && entry[lang]) {
              document.title = entry[lang];
            }
          }
        }
      }

      function syncLangButton(lang: string) {
        const btn = document.getElementById('lang-toggle');
        if (!btn) return;
        const label = lang === 'de' ? 'DE' : 'EN';
        // Clear any leftover transition spans and set the current one
        const existing = btn.querySelector('.now');
        if (existing) {
          existing.textContent = label;
        }
      }

      // ── Nav scroll background ──────────────────────────────
      let scrollHandler: (() => void) | null = null;

      function initNavScroll() {
        const nav = document.querySelector('[data-nav-bg]') as HTMLElement | null;
        if (!nav) return;

        // Remove previous listener if exists (avoid stacking)
        if (scrollHandler) {
          window.removeEventListener('scroll', scrollHandler);
        }

        scrollHandler = () => {
          const scrolled = window.scrollY > 8;
          nav.style.background = scrolled
            ? 'color-mix(in oklab, var(--bg) 70%, transparent)'
            : 'color-mix(in oklab, var(--bg) 55%, transparent)';
        };
        scrollHandler();
        window.addEventListener('scroll', scrollHandler, { passive: true });
      }

      // ── Scroll spy ─────────────────────────────────────────
      let spyHandler: (() => void) | null = null;

      function initScrollSpy() {
        if (spyHandler) {
          window.removeEventListener('scroll', spyHandler);
          spyHandler = null;
        }

        const wrap = document.getElementById('nav-links');
        if (!wrap) return;
        const links = [...wrap.querySelectorAll('a')];
        const map = links
          .map((a) => {
            const href = a.getAttribute('href') || '';
            if (!href.includes('#')) return null;
            const hash = '#' + href.split('#')[1];
            if (hash === '#') return null;
            const sec = document.querySelector(hash);
            if (!sec) return null;
            return { a, sec: sec as HTMLElement };
          })
          .filter(Boolean) as { a: HTMLAnchorElement; sec: HTMLElement }[];
        if (!map.length) return;

        let active: HTMLAnchorElement | null = null;
        spyHandler = () => {
          const y = window.scrollY + 140;
          let cur: HTMLAnchorElement | null = null;
          for (const { a, sec } of map) {
            if (sec.offsetTop <= y) cur = a;
          }
          if (cur !== active) {
            if (active) active.classList.remove('active');
            active = cur;
            if (active) active.classList.add('active');
          }
        };
        window.addEventListener('scroll', spyHandler, { passive: true });
        spyHandler();
      }

      // ── Page init (runs on first load AND after every view transition) ──
      function initPage() {
        // Theme: sync icons to current data-theme
        syncThemeIcons();

        // Theme toggle button
        const themeBtn = document.getElementById('theme-toggle');
        if (themeBtn) {
          // Replace to remove old listeners
          const fresh = themeBtn.cloneNode(true) as HTMLElement;
          themeBtn.parentNode!.replaceChild(fresh, themeBtn);
          fresh.addEventListener('click', () => {
            const current = document.documentElement.getAttribute('data-theme');
            setTheme(current === 'dark' ? 'light' : 'dark');
          });
        }

        // Lang toggle button
        const langBtn = document.getElementById('lang-toggle');
        if (langBtn) {
          const fresh = langBtn.cloneNode(true) as HTMLElement;
          langBtn.parentNode!.replaceChild(fresh, langBtn);
          fresh.addEventListener('click', () => {
            const current = getLang();
            const next = current === 'en' ? 'de' : 'en';

            // Slide animation
            const cur = fresh.querySelector('.now');
            if (cur) {
              const nextLabel = next === 'de' ? 'DE' : 'EN';
              const span = document.createElement('span');
              span.className = 'in';
              span.textContent = nextLabel;
              fresh.appendChild(span);
              requestAnimationFrame(() => {
                cur.classList.remove('now');
                cur.classList.add('out');
                requestAnimationFrame(() => {
                  span.classList.remove('in');
                  span.classList.add('now');
                });
              });
              setTimeout(() => cur.remove(), 500);
            }

            setLang(next);
          });
        }

        // Apply saved language
        const lang = getLang();
        if (lang !== 'en') {
          applyTranslations(lang);
          syncLangButton(lang);
          document.documentElement.setAttribute('lang', 'de');
        }

        // Nav scroll + spy
        initNavScroll();
        initScrollSpy();
      }

      // Astro's lifecycle: fires on initial load and after every client-side navigation
      document.addEventListener('astro:page-load', initPage);

      // Also restore theme immediately after DOM swap (before paint)
      document.addEventListener('astro:after-swap', () => {
        const theme = document.documentElement.getAttribute('data-theme')
          || (() => { try { return localStorage.getItem('theme'); } catch (e) { return null; } })()
          || 'light';
        document.documentElement.setAttribute('data-theme', theme);
        syncThemeIcons();
      });
    </script>
  </body>
</html>
