---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AsciiArt from '../../components/ui/AsciiArt.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import JsonLd from '../../components/layout/JsonLd.astro';
import { getCollection, render } from 'astro:content';
import { buildDeMap } from '../../lib/content-helpers';
import { t } from '../../lib/i18n';

const lang = 'de';
export const prerender = true;

export async function getStaticPaths() {
  const en = await getCollection('projects');
  const deEntries = await getCollection('projectsDe');
  const deMap = buildDeMap(deEntries);
  return en.map((project) => {
    const de = deMap.get(project.id);
    const deSlug = de?.data.urlSlug || project.id;
    return { params: { post: deSlug }, props: { project } };
  });
}

const { project } = Astro.props;

const allEn = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const deProjects = await getCollection('projectsDe');
const deMap = buildDeMap(deProjects);
const de = deMap.get(project.id);

const contentEntry = de || project;
const { Content } = await render(contentEntry);
const displayTitle = de?.data.title || project.data.title;
const displayDesc = de?.data.description || project.data.description;

const currentIndex = allEn.findIndex((p) => p.id === project.id);
const nextProject = allEn[currentIndex + 1] || null;
const nextDe = nextProject ? deMap.get(nextProject.id) : undefined;
const nextSlug = nextDe?.data.urlSlug || nextProject?.id;
const total = allEn.length;
const orderStr = String(project.data.order).padStart(2, '0');
const totalStr = String(total).padStart(2, '0');
const altLangUrl = `/en/work/${project.id}/`;
---

<BaseLayout title={displayTitle} description={displayDesc} activeNav="work" ogType="article" publishedAt={project.data.publishedAt} lang={lang} altLangUrl={altLangUrl}>
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: displayTitle,
    description: displayDesc,
    datePublished: project.data.publishedAt.toISOString(),
    author: { '@type': 'Person', name: 'Dragan Balatinac', url: 'https://balatinac.dev' },
    publisher: { '@type': 'Person', name: 'Dragan Balatinac' },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    url: new URL(Astro.url.pathname, Astro.site).toString(),
  }} />
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://balatinac.dev/' },
      { '@type': 'ListItem', position: 2, name: 'Projekte', item: 'https://balatinac.dev/work/' },
      { '@type': 'ListItem', position: 3, name: displayTitle },
    ],
  }} />

  <header class="page-intro page-intro--art">
    <AsciiArt slot="figure" lang={lang} class="ascii-cover--side" />
    <Breadcrumbs items={[
      { label: t('crumb.home', lang), href: '/' },
      { label: t('crumb.work', lang), href: '/work/' },
      { label: displayTitle },
    ]} />
    <div class="page-intro__copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10" data-reveal-group>
      <div class="max-w-[760px]">
        <h1 class="h1-page m-0" data-reveal>{displayTitle}</h1>
        <p class="lead text-muted mt-6 mb-0 max-w-[52ch] text-pretty" data-reveal>{displayDesc}</p>
      </div>
    </div>
  </header>

  <div class="meta-bar">
    <dl class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10">
      <div><dt>{t('meta.caseStudy', lang)}</dt><dd>{orderStr} / {totalStr}</dd></div>
      <div><dt>{t('meta.year', lang)}</dt><dd>{project.data.year}</dd></div>
      {(de?.data.meta?.duration || project.data.meta?.duration) && <div><dt>{t('meta.duration', lang)}</dt><dd>{(de?.data.meta?.duration || project.data.meta?.duration)}</dd></div>}
      {(de?.data.meta?.role || project.data.meta?.role) && <div><dt>{t('meta.role', lang)}</dt><dd>{(de?.data.meta?.role || project.data.meta?.role)}</dd></div>}
      {(de?.data.meta?.team || project.data.meta?.team) && <div><dt>{t('meta.team', lang)}</dt><dd>{(de?.data.meta?.team || project.data.meta?.team)}</dd></div>}
      {(de?.data.meta?.status || project.data.meta?.status) && <div><dt>{t('meta.status', lang)}</dt><dd>{(de?.data.meta?.status || project.data.meta?.status)}</dd></div>}
    </dl>
  </div>

  <article class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 pt-[clamp(48px,6vw,80px)] pb-[clamp(72px,9vw,112px)]">
    <div class="prose-article">
      <Content />
    </div>
  </article>

  {nextProject && (
    <nav class="border-t border-rule" aria-label={t('meta.next', lang)}>
      <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10">
        <a class="next-link" href={`/work/${nextSlug}/`}>
          <span>
            <span class="block text-[14px] text-muted">{t('meta.next', lang)} · {String(nextProject.data.order).padStart(2, '0')} / {totalStr}</span>
            <span class="next-link__title">{nextDe?.data.title || nextProject.data.title}</span>
          </span>
          <span class="next-link__arrow" aria-hidden="true">-&gt;</span>
        </a>
      </div>
    </nav>
  )}
</BaseLayout>
