---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AsciiArt from '../../../components/ui/AsciiArt.astro';
import Card from '../../../components/ui/Card.astro';
import Breadcrumbs from '../../../components/ui/Breadcrumbs.astro';
import JsonLd from '../../../components/layout/JsonLd.astro';
import { getCollection, render } from 'astro:content';
import { buildDeMap, getDeSlug } from '../../../lib/content-helpers';
import { t } from '../../../lib/i18n';

const lang = 'en';
export const prerender = true;

export async function getStaticPaths() {
  const en = await getCollection('blog');
  return en.map((post) => ({ params: { post: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allEn = (await getCollection('blog')).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const dePosts = await getCollection('blogDe');
const deMap = buildDeMap(dePosts);
const deSlug = getDeSlug(post, deMap);

const currentIndex = allEn.findIndex((p) => p.id === post.id);
const nextPost = allEn[currentIndex + 1] || null;

const dateStr = post.data.publishedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
const altLangUrl = `/blog/${deSlug}/`;
const relatedPosts = allEn
  .filter((p) => p.id !== post.id && p.data.tags.some((tag) => post.data.tags.includes(tag)))
  .slice(0, 3);
---

<BaseLayout title={post.data.title} description={post.data.description} activeNav="writing" ogType="article" publishedAt={post.data.publishedAt} lang={lang} altLangUrl={altLangUrl}>
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.publishedAt.toISOString(),
    author: { '@type': 'Person', name: 'Dragan Balatinac', url: 'https://balatinac.dev' },
    publisher: { '@type': 'Person', name: 'Dragan Balatinac' },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
    url: new URL(Astro.url.pathname, Astro.site).toString(),
  }} />
  <JsonLd schema={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://balatinac.dev/en/' },
      { '@type': 'ListItem', position: 2, name: 'Writing', item: 'https://balatinac.dev/en/blog/' },
      { '@type': 'ListItem', position: 3, name: post.data.title },
    ],
  }} />

  <header class="page-intro page-intro--art">
    <AsciiArt slot="band" lang={lang} class="ascii-cover--band" />
    <Breadcrumbs items={[
      { label: t('crumb.home', lang), href: '/en/' },
      { label: t('crumb.writing', lang), href: '/en/blog/' },
      { label: post.data.title },
    ]} />
    <div class="page-intro__copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10" data-reveal-group>
      <h1 class="h1-page m-0 max-w-[20ch]" data-reveal>{post.data.title}</h1>
      <p class="lead text-muted mt-6 mb-0 max-w-[56ch] text-pretty" data-reveal>{post.data.description}</p>
    </div>
  </header>

  <div class="meta-bar">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 flex flex-wrap items-center gap-x-8">
      <dl>
        <div><dt>{t('meta.published', lang)}</dt><dd>{dateStr}</dd></div>
        <div><dt>{t('meta.readTime', lang)}</dt><dd>{post.data.readTime || '~5 min'}</dd></div>
      </dl>
      <ul class="tag-list" aria-label="Tags">
        {post.data.tags.map((tag) => (
          <li><a href={`/en/blog/?tag=${tag.toLowerCase()}`}><span class="text-accent" aria-hidden="true">#</span>{tag}</a></li>
        ))}
      </ul>
    </div>
  </div>

  <article class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 pt-[clamp(48px,6vw,80px)] pb-[clamp(72px,9vw,112px)]">
    <div class="prose-article">
      <Content />
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="border-t border-rule" aria-labelledby="related-title">
      <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 py-[clamp(48px,6vw,72px)]">
        <h2 id="related-title" class="h3-section m-0">{t('blog.relatedPosts', lang)}</h2>
        <ul class="card-grid card-grid--wide mt-7">
          {relatedPosts.map((rp) => (
            <Card
              href={`/en/blog/${rp.id}/`}
              title={rp.data.title}
              description={rp.data.description}
              meta={rp.data.publishedAt.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
            />
          ))}
        </ul>
      </div>
    </section>
  )}

  <nav class="border-t border-rule" aria-label="Post navigation">
    <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 grid grid-cols-1 sm:grid-cols-2">
      <a class="post-nav" href="/en/blog/">
        <span class="block text-[14px] text-muted">{t('blog.backToWriting', lang)}</span>
        <span class="post-nav__title">{t('blog.allPosts', lang)}</span>
      </a>
      {nextPost && (
        <a class="post-nav post-nav--next" href={`/en/blog/${nextPost.id}/`}>
          <span class="block text-[14px] text-muted">{t('blog.nextPost', lang)} →</span>
          <span class="post-nav__title">{nextPost.data.title}</span>
        </a>
      )}
    </div>
  </nav>
</BaseLayout>
