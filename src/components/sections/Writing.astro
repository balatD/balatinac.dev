---
import { getCollection } from 'astro:content';
import { buildDeMap, getLocalizedEntry } from '../../lib/content-helpers';
import type { Lang } from '../../lib/i18n';
import { t, langPrefix, dateLocale } from '../../lib/i18n';
import Card from '../ui/Card.astro';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
const prefix = langPrefix(lang);

const enPosts = await getCollection('blog');
const dePosts = await getCollection('blogDe');
const posts = enPosts
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
  .slice(0, 4);
const deMap = buildDeMap(dePosts);
const hasPosts = posts.length > 0;
---

<section id="writing" class="section mx-auto max-w-wrap px-5 sm:px-8 md:px-10" aria-labelledby="writing-title" data-reveal-group>
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
    <h2 id="writing-title" class="h2-section m-0" data-reveal>{t('writing.label', lang)}</h2>
    <a class="link-accent text-[15px] font-medium py-3" href={`${prefix}/blog/`} data-reveal>{t('writing.all', lang)}</a>
  </div>
  {hasPosts ? (
    <ul class="card-grid card-grid--wide mt-9">
      {posts.map((post) => {
        const { title, description, slug } = getLocalizedEntry(post, deMap, lang);
        const dateStr = post.data.publishedAt.toLocaleDateString(dateLocale(lang), { month: 'short', year: 'numeric' });
        const readTime = (lang === 'de' && deMap.get(post.id)?.data.readTime) || post.data.readTime;
        return (
          <Card
            href={`${prefix}/blog/${slug}/`}
            title={title}
            description={description}
            meta={readTime ? `${dateStr} · ${readTime}` : dateStr}
          />
        );
      })}
    </ul>
  ) : (
    <p class="text-[17px] text-muted mt-9" data-reveal>{t('empty.blog', lang)}</p>
  )}
</section>
