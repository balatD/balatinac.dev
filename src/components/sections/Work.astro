---
import { getCollection } from 'astro:content';
import { getEnEntries, getDeMap } from '../../lib/content-helpers';

const all = await getCollection('projects');
const projects = getEnEntries(all).sort((a, b) => a.data.order - b.data.order).slice(0, 4);
const deMap = getDeMap(all);
const hasProjects = projects.length > 0;
---

<section id="work" class="py-14 sm:py-16 md:py-20 border-t border-rule">
  <div class="mx-auto max-w-wrap px-5 sm:px-7 md:px-8">
    <p class="font-mono text-[13px] text-muted m-0 mb-7 md:mb-8" data-i18n="work.label">Selected work</p>
    {hasProjects ? (
      <>
        <ul class="list-none p-0 m-0 divide-y divide-rule">
          {projects.map((project) => {
            const de = deMap.get(project.id);
            return (
              <li>
                <a class="grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-1 sm:gap-6 sm:items-baseline py-5 hover:text-accent transition-colors group" href={`/work/${project.id}/`}>
                  <div>
                    <div class="text-[17px] font-medium leading-snug text-balance" data-de={de?.data.title}>{project.data.title}</div>
                    <div class="text-[14px] sm:text-[15px] text-muted mt-1 text-pretty" data-de={de?.data.description}>{project.data.description}</div>
                  </div>
                  <div class="font-mono text-[12px] sm:text-[13px] text-muted whitespace-nowrap group-hover:text-accent transition-colors">{project.data.year}</div>
                </a>
              </li>
            );
          })}
        </ul>
        <p class="mt-7 font-mono text-[13px]">
          <a class="text-muted hover:text-accent after:content-['_→']" href="/work/" data-i18n="work.all">All work</a>
        </p>
      </>
    ) : (
      <p class="text-[17px] text-muted" data-i18n="empty.work">Projects coming soon.</p>
    )}
  </div>
</section>
