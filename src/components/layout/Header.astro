---
import type { Lang } from '../../lib/i18n';
import { t, langPrefix, langSwitchUrl } from '../../lib/i18n';

interface Props {
  activeNav?: 'about' | 'work' | 'writing' | 'contact';
  lang?: Lang;
  altLangUrl?: string;
}

const { activeNav, lang = 'de', altLangUrl } = Astro.props;
const prefix = langPrefix(lang);
const altUrl = altLangUrl || langSwitchUrl(Astro.url.pathname, lang);
const altLang = lang === 'de' ? 'en' : 'de';
// Written in the target language, matching the link's lang attribute.
const altLabel = altLang === 'en' ? 'Read in English' : 'Auf Deutsch lesen';

const navLinks = [
  { href: `${prefix}/#about`, label: t('nav.about', lang), id: 'about' },
  { href: `${prefix}/work/`, label: t('nav.work', lang), id: 'work' },
  { href: `${prefix}/blog/`, label: t('nav.writing', lang), id: 'writing' },
  { href: `${prefix}/#contact`, label: t('nav.contact', lang), id: 'contact' },
];
---

<header class="site-header">
  <div class="mx-auto max-w-wrap px-5 sm:px-8 md:px-10 py-2 flex flex-wrap items-center justify-between gap-x-6">
    <a href={`${prefix}/`} aria-label="dragan — home" class="wordmark">dragan<span class="wordmark-dot">.</span></a>

    <nav class="order-last w-full sm:order-none sm:w-auto flex flex-wrap -mx-3 sm:mx-0" aria-label="Primary">
      {navLinks.map((link) => (
        <a
          class:list={['nav-link', activeNav === link.id && 'is-active']}
          href={link.href}
          aria-current={activeNav === link.id ? 'page' : undefined}
        >{link.label}</a>
      ))}
    </nav>

    <div class="flex items-center gap-1">
      <a class="icon-btn" href={altUrl} hreflang={altLang} lang={altLang} aria-label={altLabel} title={altLabel}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18" /><path d="M12 3a14 14 0 0 1 0 18a14 14 0 0 1 0-18z" /></svg>
      </a>
      <button id="theme-toggle" type="button" class="icon-btn">
        <span class="sr-only">{t('theme.prefix', lang)}<span class="theme-to-dark">{t('theme.dark', lang)}</span><span class="theme-to-light">{t('theme.light', lang)}</span>{t('theme.suffix', lang)}</span>
        <svg class="theme-to-dark" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
        <svg class="theme-to-light" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" /></svg>
      </button>
    </div>
  </div>
</header>
