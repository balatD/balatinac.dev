---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';
import AsciiArt from '../ui/AsciiArt.astro';

interface Props { lang?: Lang; }
const { lang = 'de' } = Astro.props;
---

<section id="contact" class="contact" aria-labelledby="contact-title" data-reveal-group>
  <AsciiArt slot="band" lang={lang} class="ascii-cover--bottom" />
  <div class="contact-copy mx-auto max-w-wrap px-5 sm:px-8 md:px-10">
    <h2 id="contact-title" class="h2-section m-0" data-reveal>{t('contact.label', lang)}</h2>
    <p class="mt-7 mb-0" data-reveal>
      <a class="contact-email" href="mailto:hello@balatinac.com">hello@balatinac.com</a>
    </p>
    <ul class="list-none p-0 mt-6 mb-0 flex flex-wrap gap-3" data-reveal>
      <li><a class="pill" href="https://github.com/balatD" rel="noopener">github.com/balatD</a></li>
      <li><a class="pill" href="https://www.linkedin.com/in/dragan-balatinac/" rel="noopener">linkedin.com/in/dragan-balatinac</a></li>
    </ul>
  </div>
</section>
